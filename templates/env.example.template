# .env.example — every variable this project reads, and nothing else.
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. Never put a real value in this file, not even an
# expired one. Production values come from the platform's secret store.
#
# Format per entry:
#   # <what it is>. <required|optional, default X>. <format>
#   NAME=
#
# Precedence: real environment > .env > defaults in code.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Deployment environment. Optional, default "development". One of: development, test, production
APP_ENV=

# Log level. Optional, default "info". One of: debug, info, warning, error
LOG_LEVEL=

# ── Model providers (only the ones this project actually calls) ───────────────
# Anthropic API key. Required if the Claude integration is enabled.
ANTHROPIC_API_KEY=

# OpenAI API key. Required if the OpenAI integration is enabled.
OPENAI_API_KEY=

# Google Gemini API key. Required if the Gemini integration is enabled.
# Set GEMINI_API_KEY *or* GOOGLE_API_KEY, not both.
GEMINI_API_KEY=

# ── Datastores ───────────────────────────────────────────────────────────────
# Connection URL. Required. Format: scheme://user:password@host:port/db
DATABASE_URL=
