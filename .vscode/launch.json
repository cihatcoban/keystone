{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: validate_repo.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_repo.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: check_triggers.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_triggers.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: new_skill.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/new_skill.py",
      "args": ["${input:newSkillName}"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    { "id": "newSkillName", "type": "promptString", "description": "kebab-case skill name" }
  ]
}
