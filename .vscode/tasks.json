{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate repository",
      "type": "shell",
      "command": "python3 scripts/validate_repo.py",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "clear": true
      },
      "problemMatcher": {
        "owner": "keystone",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:ERROR|warn)\\s+([^:]+):\\s+(.*)$",
          "file": 1,
          "message": 2
        }
      }
    },
    {
      "label": "Check skill triggers",
      "type": "shell",
      "command": "python3 scripts/check_triggers.py",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint markdown",
      "type": "shell",
      "command": "make lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "New skill…",
      "type": "shell",
      "command": "python3 scripts/new_skill.py ${input:skillName} --category ${input:skillCategory}",
      "problemMatcher": []
    },
    {
      "label": "Skill word counts",
      "type": "shell",
      "command": "wc -w skills/*/SKILL.md | sort -n",
      "problemMatcher": []
    },
    {
      "label": "Run tooling tests",
      "type": "shell",
      "command": "make test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Regenerate agent adapters",
      "type": "shell",
      "command": "make adapters",
      "problemMatcher": []
    },
    {
      "label": "Check .env and secrets",
      "type": "shell",
      "command": "make env-check",
      "group": "test",
      "problemMatcher": {
        "owner": "keystone-env",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(ERROR|warn)\\s+(\\w+)\\s+([^:]+):(\\d+)?:?\\s*(.*)$",
          "severity": 1,
          "code": 2,
          "file": 3,
          "line": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Agent CLIs installed?",
      "type": "shell",
      "command": "make agents-doctor",
      "problemMatcher": []
    },
    {
      "label": "Pre-commit: all checks",
      "type": "shell",
      "command": "make all",
      "group": "test",
      "presentation": {
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "skillName",
      "type": "promptString",
      "description": "kebab-case skill name"
    },
    {
      "id": "skillCategory",
      "type": "pickString",
      "description": "category",
      "options": [
        "meta",
        "define",
        "architect",
        "build",
        "verify",
        "operate"
      ],
      "default": "build"
    }
  ]
}
