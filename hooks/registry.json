{
  "$comment": "Source of truth for Keystone hooks. Manifests in hooks/*.json are generated from this file by scripts/build_adapters.py. Hook IDs are a public interface: renaming one is a MAJOR change (ADR-001).",
  "triggers": {
    "shell": {
      "description": "before the agent runs a shell command",
      "timeout_s": 10,
      "claude-code": {
        "event": "PreToolUse",
        "matcher": "Bash"
      },
      "codex": {
        "event": "PreToolUse",
        "matcher": "^(Bash|exec_command)$"
      },
      "gemini": {
        "event": "BeforeTool",
        "matcher": "^run_shell_command$"
      }
    },
    "edit": {
      "description": "before the agent writes or edits a file",
      "timeout_s": 10,
      "claude-code": {
        "event": "PreToolUse",
        "matcher": "Write|Edit|MultiEdit"
      },
      "codex": {
        "event": "PreToolUse",
        "matcher": "^apply_patch$"
      },
      "gemini": {
        "event": "BeforeTool",
        "matcher": "^(write_file|replace)$"
      }
    },
    "stop": {
      "description": "when the agent is about to end its turn",
      "timeout_s": 30,
      "claude-code": {
        "event": "Stop"
      },
      "codex": {
        "event": "Stop"
      },
      "gemini": {
        "event": "AfterAgent"
      }
    },
    "pre-compact": {
      "description": "before the conversation is compacted",
      "timeout_s": 10,
      "claude-code": {
        "event": "PreCompact"
      },
      "codex": {
        "event": "PreCompact"
      },
      "gemini": {
        "event": "PreCompress"
      }
    },
    "session-start": {
      "description": "when a session starts, resumes or is compacted",
      "timeout_s": 10,
      "claude-code": {
        "event": "SessionStart"
      },
      "codex": {
        "event": "SessionStart"
      },
      "gemini": {
        "event": "SessionStart"
      }
    }
  },
  "hooks": [
    {
      "id": "bar.constraints-lowered",
      "trigger": [
        "edit"
      ],
      "invariants": [
        4,
        5
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A number in CONSTRAINTS.md moves in the permissive direction."
    },
    {
      "id": "bar.check-config",
      "trigger": [
        "edit"
      ],
      "invariants": [
        5
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A config file of a tool named in CONSTRAINTS.md, or a protected path, is edited."
    },
    {
      "id": "bar.suppression",
      "trigger": [
        "edit"
      ],
      "invariants": [
        5
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A new lint or type suppression without a justification and a tracking link."
    },
    {
      "id": "bar.test-weakened",
      "trigger": [
        "edit",
        "shell"
      ],
      "invariants": [
        5
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A test is skipped, focused, removed or deleted."
    },
    {
      "id": "git.no-verify",
      "trigger": [
        "shell"
      ],
      "invariants": [
        5
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A git command bypasses or redirects the repository's own hooks."
    },
    {
      "id": "git.force-push",
      "trigger": [
        "shell"
      ],
      "invariants": [
        3
      ],
      "warn": "ask",
      "strict": "block",
      "summary": "A force push, or a history rewrite, targets a protected branch."
    },
    {
      "id": "git.commit-message",
      "trigger": [
        "shell"
      ],
      "invariants": [
        6
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "A commit message breaks the project's own commit convention."
    },
    {
      "id": "secret.staged",
      "trigger": [
        "shell"
      ],
      "invariants": [
        8
      ],
      "warn": "ask",
      "strict": "block",
      "summary": "A git commit would record a credential-shaped string."
    },
    {
      "id": "secret.write",
      "trigger": [
        "edit"
      ],
      "invariants": [
        8
      ],
      "warn": "ask",
      "strict": "block",
      "summary": "A file write contains a credential-shaped string."
    },
    {
      "id": "irreversible.command",
      "trigger": [
        "shell"
      ],
      "invariants": [
        3
      ],
      "warn": "ask",
      "strict": "ask",
      "summary": "A command deletes data, discards work, destroys infrastructure or publishes."
    },
    {
      "id": "rules.project",
      "trigger": [
        "shell",
        "edit"
      ],
      "invariants": [],
      "warn": "rule",
      "strict": "rule",
      "summary": "A project rule in .keystone/rules/*.md matches; the rule sets its own action."
    },
    {
      "id": "verify.stop",
      "trigger": [
        "stop"
      ],
      "invariants": [
        1,
        10
      ],
      "warn": "warn",
      "strict": "block",
      "summary": "The turn ends with changes that /verify has not passed."
    }
  ],
  "review_only_invariants": {
    "2": "Discovery is a reading habit; no tool call reveals that a command was invented rather than found.",
    "7": "Boundary rules are project-specific; mechanical checks arrive with the 1.4.0 traceability graph.",
    "9": "Whether a model decides in a production path is a property of the design, judged in review."
  }
}
