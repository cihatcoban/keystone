{
  "description": "Keystone hooks for codex. GENERATED by scripts/build_adapters.py from hooks/registry.json; do not edit. See docs/hooks.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}\"/hooks/run.sh --harness codex --trigger shell",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}\"/hooks/run.sh --harness codex --trigger edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
