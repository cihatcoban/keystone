{
  "description": "Keystone hooks for gemini. GENERATED by scripts/build_adapters.py from hooks/registry.json; do not edit. See docs/hooks.md.",
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "keystone-shell",
            "type": "command",
            "command": "sh \"<keystone-root>\"/hooks/run.sh --harness gemini --trigger shell",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "^(write_file|replace)$",
        "hooks": [
          {
            "name": "keystone-edit",
            "type": "command",
            "command": "sh \"<keystone-root>\"/hooks/run.sh --harness gemini --trigger edit",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "keystone-stop",
            "type": "command",
            "command": "sh \"<keystone-root>\"/hooks/run.sh --harness gemini --trigger stop",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
