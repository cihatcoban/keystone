{
  "description": "Keystone hooks for claude-code. GENERATED by scripts/build_adapters.py from hooks/registry.json; do not edit. See docs/hooks.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh --harness claude-code --trigger shell",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh --harness claude-code --trigger edit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run.sh --harness claude-code --trigger stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
