# .env.example — Keystone itself needs no configuration to run.
#
# These variables are optional and only matter if you authenticate the agent
# CLIs with API keys instead of their own login flow. Prefer the login flow
# (`claude`, `gemini`, `codex login`): no key on disk is the strongest guarantee.
#
# If you do use keys: cp .env.example .env, fill in, never commit .env.
# See skills/configuration-and-secrets and templates/agent-secret-guards.md.

# Claude Code — Anthropic API key. Optional.
ANTHROPIC_API_KEY=

# Codex — OpenAI API key. Optional.
OPENAI_API_KEY=

# Gemini CLI — Gemini API key. Optional. Set this or GOOGLE_API_KEY, not both.
GEMINI_API_KEY=
